apiVersion: v1
kind: ConfigMap
metadata:
  name: <%= app %>-routine-load-credentials
  namespace: <%= project %>
data:
  # Kafka credentials
<% kafka_credentials.each do |key, value| %>
  <%= key %>: <%= value %>
<% end %>
  # Schema Registry credentials
<% schema_registry_credentials.each do |key, value| %>
  <%= key %>: <%= value %>
<% end %> 