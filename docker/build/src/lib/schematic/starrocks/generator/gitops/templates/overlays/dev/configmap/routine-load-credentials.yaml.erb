apiVersion: v1
kind: ConfigMap
metadata:
  name: <%= app %>-routine-load-credentials
  namespace: <%= project %>
data:
  # Kafka credentials
  KAFKA_BROKER_LIST: <%= kafka_credentials['KAFKA_BROKER_LIST'] %>
  KAFKA_SECURITY_PROTOCOL: <%= kafka_credentials['KAFKA_SECURITY_PROTOCOL'] %>
  KAFKA_SASL_MECHANISM: <%= kafka_credentials['KAFKA_SASL_MECHANISM'] %>
  KAFKA_SASL_USERNAME: <%= kafka_credentials['KAFKA_SASL_USERNAME'] %>
<% if kafka_credentials['KAFKA_SASL_PASSWORD_ENCRYPTED'] %>
  KAFKA_SASL_PASSWORD_ENCRYPTED: <%= kafka_credentials['KAFKA_SASL_PASSWORD_ENCRYPTED'] %>
<% else %>
  KAFKA_SASL_PASSWORD: <%= kafka_credentials['KAFKA_SASL_PASSWORD'] %>
<% end %>
  KAFKA_SSL_VERIFY: <%= kafka_credentials['KAFKA_SSL_VERIFY'] %>
  KAFKA_PARTITIONS: <%= kafka_credentials['KAFKA_PARTITIONS'] %>
  KAFKA_OFFSET: <%= kafka_credentials['KAFKA_OFFSET'] %>

  # Schema Registry credentials
  SCHEMA_REGISTRY_URL: <%= schema_registry_credentials['SCHEMA_REGISTRY_URL'] %>
  SCHEMA_REGISTRY_USERNAME: <%= schema_registry_credentials['SCHEMA_REGISTRY_USERNAME'] %>
<% if schema_registry_credentials['SCHEMA_REGISTRY_PASSWORD_ENCRYPTED'] %>
  SCHEMA_REGISTRY_PASSWORD_ENCRYPTED: <%= schema_registry_credentials['SCHEMA_REGISTRY_PASSWORD_ENCRYPTED'] %>
<% else %>
  SCHEMA_REGISTRY_PASSWORD: <%= schema_registry_credentials['SCHEMA_REGISTRY_PASSWORD'] %>
<% end %>