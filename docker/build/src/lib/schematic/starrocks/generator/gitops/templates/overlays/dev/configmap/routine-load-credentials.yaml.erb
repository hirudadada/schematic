apiVersion: v1
kind: ConfigMap
metadata:
  name: <%= app %>-routine-load-credentials
  namespace: <%= project %>
data:
  # Kafka credentials
  KAFKA_BROKER_LIST: "<%= cluster_credentials['KAFKA_BROKER_LIST'] %>"
  KAFKA_SECURITY_PROTOCOL: "<%= cluster_credentials['KAFKA_SECURITY_PROTOCOL'] %>"
  KAFKA_SASL_MECHANISM: "<%= cluster_credentials['KAFKA_SASL_MECHANISM'] %>"
  KAFKA_SASL_USERNAME: "<%= cluster_credentials['KAFKA_SASL_USERNAME'] %>"
  KAFKA_SASL_PASSWORD_ENCRYPTED: "<%= cluster_credentials['KAFKA_SASL_PASSWORD_ENCRYPTED'] %>"
  KAFKA_SSL_VERIFY: "<%= cluster_credentials['KAFKA_SSL_VERIFY'] %>"
  KAFKA_PARTITIONS: "<%= cluster_credentials['KAFKA_PARTITIONS'] %>"
  KAFKA_OFFSET: "<%= cluster_credentials['KAFKA_OFFSET'] %>"

  # Schema Registry credentials
  SCHEMA_REGISTRY_URL: "<%= cluster_credentials['SCHEMA_REGISTRY_URL'] %>"
  SCHEMA_REGISTRY_USERNAME: "<%= cluster_credentials['SCHEMA_REGISTRY_USERNAME'] %>"
  SCHEMA_REGISTRY_PASSWORD_ENCRYPTED: "<%= cluster_credentials['SCHEMA_REGISTRY_PASSWORD_ENCRYPTED'] %>"
