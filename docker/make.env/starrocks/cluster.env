# Kafka Cluster Configuration
DEV_KAFKA_BROKER_LIST=broker1:9092,broker2:9092
DEV_KAFKA_SECURITY_PROTOCOL=SASL_SSL
DEV_KAFKA_SASL_MECHANISM=PLAIN
DEV_KAFKA_SASL_USERNAME=kafka_user
# DEV_KAFKA_SASL_PASSWORD=kafka_password
DEV_KAFKA_SASL_PASSWORD_
DEV_KAFKA_SSL_VERIFY=false
DEV_KAFKA_PARTITIONS=0,1,2
DEV_KAFKA_OFFSET=OFFSET_BEGINNING

# Schema Registry Cluster Configuration
DEV_SCHEMA_REGISTRY_URL=schema-registry:8081
DEV_SCHEMA_REGISTRY_USERNAME=registry_user
# DEV_SCHEMA_REGISTRY_PASSWORD=registry_password
DEV_SCHEMA_REGISTRY_PASSWORD_
